{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"d4d68d36-1802-4b92-9094-507b9fc3d565\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"d4d68d36-1802-4b92-9094-507b9fc3d565\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n            with dbt_artifacts_snapshots as (\n                select \n                  name,\n                  case when alias is not null then alias\n                  else name end as table_name,\n                  unique_id,\n                  owner as owners,\n                  tags,\n                  package_name,\n                  description,\n                  meta,\n                  materialization,\n                  database_name,\n                  schema_name,\n                  depends_on_macros,\n                  depends_on_nodes,\n                  original_path as full_path,\n                  path,\n                  patch_path,\n                  generated_at,\n                  unique_key,\n                  incremental_strategy\n                from `bronze_production`.`cdc_staging`.`dbt_snapshots`\n              )\n            select * from dbt_artifacts_snapshots\n        \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "d4d68d36-1802-4b92-9094-507b9fc3d565", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"d4d68d36-1802-4b92-9094-507b9fc3d565\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"d4d68d36-1802-4b92-9094-507b9fc3d565\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n            with dbt_artifacts_snapshots as (\n                select \n                  name,\n                  case when alias is not null then alias\n                  else name end as table_name,\n                  unique_id,\n                  owner as owners,\n                  tags,\n                  package_name,\n                  description,\n                  meta,\n                  materialization,\n                  database_name,\n                  schema_name,\n                  depends_on_macros,\n                  depends_on_nodes,\n                  original_path as full_path,\n                  path,\n                  patch_path,\n                  generated_at,\n                  unique_key,\n                  incremental_strategy\n                from `bronze_production`.`cdc_staging`.`dbt_snapshots`\n              )\n            select * from dbt_artifacts_snapshots\n        \n\n  ", "name": "SQLQuery", "pid": 34176, "thread": "MainThread", "ts": "2026-09-23T21:26:36.052059Z"}}
