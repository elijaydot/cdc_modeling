me\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n            with dbt_artifacts_sources as (\n                select\n                  name,\n                  source_name,\n                  unique_id,\n                  database_name,\n                  schema_name,\n                  identifier as table_name,\n                  owner as owners,\n                  tags,\n                  package_name,\n                  description,\n                  original_path as full_path,\n                  meta\n                from `bronze_production`.`cdc_staging`.`dbt_sources`\n              )\n\n            select * from dbt_artifacts_sources\n        \n\n  ", "name": "SQLQuery", "pid": 34176, "thread": "MainThread", "ts": "2026-09-23T21:27:20.443507Z"}}
