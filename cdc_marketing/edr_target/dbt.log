del.cdc_marketing.int_facebook_ads_details\", \"invocation_id\": \"822d8953-2c20-4702-9d20-8cfbd97e61df\", \"name\": \"int_facebook_ads_details\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 15.9, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-26 17:03:11\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_account_history\", \"invocation_id\": \"822d8953-2c20-4702-9d20-8cfbd97e61df\", \"name\": \"stg_facebook_ads_account_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 18.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-26 17:03:11\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_ad_set_history\", \"invocation_id\": \"822d8953-2c20-4702-9d20-8cfbd97e61df\", \"name\": \"stg_facebook_ads_ad_set_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 18.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-26 17:03:11\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_campaign_history\", \"invocation_id\": \"822d8953-2c20-4702-9d20-8cfbd97e61df\", \"name\": \"stg_facebook_ads_campaign_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 18.4, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-26 17:03:11\"}, {\"unique_id\": \"model.cdc_marketing.fct_facebook_ads_stats_daily\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"fct_facebook_ads_stats_daily\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 90.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\nWITH all_ad_stats AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_basic_all_levels`\\n),\\n/*\\n    Formatted\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK\\n        ad_id,\\n        -- Metrics\\n        ad_spend,\\n       -- ad_impressions,\\n       -- ad_clicks,\\n        -- Metadata\\n        ad_date\\n    FROM\\n        all_ad_stats \\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_account_history\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_account_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 113.4, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"WITH source_data AS (\\n\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`accounts`\\n\\n\\n),\\n\\n/*\\n    Transformations\\n*/\\n\\nformatted AS (\\n\\n    SELECT\\n        -- FK\\n        CAST(account_id AS STRING) AS account_id,\\n\\n        -- Details\\n        CAST(account_name AS STRING) AS account_name,\\n        CAST(ad_currency_code AS STRING) AS ad_currency_code,\\n\\n        -- Metadata\\n        CAST(account_created_at AS TIMESTAMP) AS account_created_at,\\n        CAST(account_updated_at AS TIMESTAMP) AS account_updated_at\\n    FROM\\n        source_data\\n)\\n\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_ad_history\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_ad_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 105.8, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\nWITH source_data AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`ads`\\n),\\n/*\\n    Transformations\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK\\n        CAST(ad_id AS STRING) AS ad_id,\\n        CAST(campaign_id AS STRING) AS campaign_id,\\n        CAST(ad_group_id AS STRING) AS ad_group_id,\\n        CAST(account_id AS STRING) AS account_id,\\n        -- Details\\n        CAST(ad_name AS STRING) AS ad_name,\\n        CAST(ad_status AS STRING) AS ad_status,\\n        -- Metadata\\n        CAST(ad_updated_at AS TIMESTAMP) AS ad_updated_at\\n    FROM\\n        source_data\\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_ad_set_history\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_ad_set_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 113.3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\nWITH source_data AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`adgroups`\\n),\\n/*\\n    Transformations\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK\\n        CAST(ad_group_id AS STRING) AS ad_group_id,\\n        -- Details\\n        CAST(ad_group_name AS STRING) AS ad_group_name,\\n        -- Metadata\\n        CAST(ad_group_updated_at AS TIMESTAMP) AS ad_group_updated_at\\n    FROM\\n        source_data\\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_basic_all_levels\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_basic_all_levels\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 105.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n/*\\n    Tables\\n*/\\nWITH source_data AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`ads_stats`\\n),\\n/*\\n    Transformations\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK\\n        CAST(ad_id AS STRING) AS ad_id,\\n        CAST(account_id AS STRING) AS account_id,\\n        -- Measures\\n        CAST(ad_spend AS DOUBLE) AS ad_spend,\\n        CAST(ad_impressions AS INTEGER) AS ad_impressions,\\n        CAST(ad_clicks AS INTEGER) AS ad_clicks,\\n        -- Metadata\\n        CAST(ad_date AS DATE) AS ad_date\\n    FROM\\n        source_data\\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_campaign_history\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_campaign_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 105.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\nWITH source_data AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`campaigns`\\n),\\n/*\\n    Transformations\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK\\n        CAST(campaign_id AS STRING) AS campaign_id,\\n        -- Details\\n        CAST(campaign_name AS STRING) AS campaign_name,\\n        -- Metadata\\n        CAST(campaign_updated_at AS TIMESTAMP) AS campaign_updated_at\\n    FROM\\n        source_data\\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.dim_facebook_ads_details\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"dim_facebook_ads_details\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 23.5, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\n\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`int_facebook_ads_details`\", \"generated_at\": \"2026-09-28 21:10:25\"}, {\"unique_id\": \"model.cdc_marketing.int_facebook_ads_details\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"int_facebook_ads_details\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 108.8, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\n\\nWITH all_ads AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_ad_history`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY ad_id\\n        ORDER BY ad_updated_at DESC\\n    ) = 1\\n\\n),\\n\\nad_groups AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_ad_set_history`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY ad_group_id\\n        ORDER BY ad_group_updated_at DESC\\n    ) = 1\\n\\n),\\n\\nall_campaigns AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_campaign_history`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY campaign_id\\n        ORDER BY campaign_updated_at DESC\\n    ) = 1\\n\\n),\\n\\naccount_details AS (\\n\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_account_history`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY account_id\\n        ORDER BY account_updated_at DESC\\n    ) = 1\\n\\n),\\n\\n/*\\n    Transformations\\n*/\\n\\njoin_all_details AS (\\n\\n    SELECT\\n        all_ads.*,\\n        ad_groups.ad_group_name,\\n        all_campaigns.campaign_name,\\n        account_details.account_name,\\n        GREATEST(\\n            all_ads.ad_updated_at,\\n            ad_groups.ad_group_updated_at,\\n            all_campaigns.campaign_updated_at,\\n            account_details.account_created_at\\n        ) AS ad_detail_updated_at\\n    FROM\\n        all_ads\\n    LEFT JOIN\\n        ad_groups\\n        ON\\n            all_ads.ad_group_id = ad_groups.ad_group_id\\n    LEFT JOIN\\n        all_campaigns\\n        ON\\n            all_ads.campaign_id = all_campaigns.campaign_id\\n    LEFT JOIN\\n        account_details\\n        ON\\n            all_ads.account_id = account_details.account_id\\n\\n),\\n\\n\\n/*\\n    Formatted\\n*/\\n\\nformatted AS (\\n\\n    SELECT\\n        ad_id,\\n\\n        -- FK\\n        ad_group_id,\\n        campaign_id,\\n        account_id,\\n        \\n        -- Details\\n        ad_name,\\n        ad_group_name,\\n        camp