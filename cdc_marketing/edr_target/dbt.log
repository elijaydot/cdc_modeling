del.cdc_marketing.int_facebook_ads_details\", \"invocation_id\": \"822d8953-2c20-4702-9d20-8cfbd97e61df\", \"name\": \"int_facebook_ads_details\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 15.9, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-26 17:03:11\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_account_history\", \"invocation_id\": \"822d8953-2c20-4702-9d20-8cfbd97e61df\", \"name\": \"stg_facebook_ads_account_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 18.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-26 17:03:11\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_ad_set_history\", \"invocation_id\": \"822d8953-2c20-4702-9d20-8cfbd97e61df\", \"name\": \"stg_facebook_ads_ad_set_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 18.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-26 17:03:11\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_campaign_history\", \"invocation_id\": \"822d8953-2c20-4702-9d20-8cfbd97e61df\", \"name\": \"stg_facebook_ads_campaign_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 18.4, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-26 17:03:11\"}, {\"unique_id\": \"model.cdc_marketing.fct_facebook_ads_stats_daily\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"fct_facebook_ads_stats_daily\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 90.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\nWITH all_ad_stats AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_basic_all_levels`\\n),\\n/*\\n    Formatted\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK\\n        ad_id,\\n        -- Metrics\\n        ad_spend,\\n       -- ad_impressions,\\n       -- ad_clicks,\\n        -- Metadata\\n        ad_date\\n    FROM\\n        all_ad_stats \\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_account_history\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_account_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 113.4, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"WITH source_data AS (\\n\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`accounts`\\n\\n\\n),\\n\\n/*\\n    Transformations\\n*/\\n\\nformatted AS (\\n\\n    SELECT\\n        -- FK\\n        CAST(account_id AS STRING) AS account_id,\\n\\n        -- Details\\n        CAST(account_name AS STRING) AS account_name,\\n        CAST(ad_currency_code AS STRING) AS ad_currency_code,\\n\\n        -- Metadata\\n        CAST(account_created_at AS TIMESTAMP) AS account_created_at,\\n        CAST(account_updated_at AS TIMESTAMP) AS account_updated_at\\n    FROM\\n        source_data\\n)\\n\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_ad_history\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_ad_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 105.8, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\nWITH source_data AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`ads`\\n),\\n/*\\n    Transformations\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK\\n        CAST(ad_id AS STRING) AS ad_id,\\n        CAST(campaign_id AS STRING) AS campaign_id,\\n        CAST(ad_group_id AS STRING) AS ad_group_id,\\n        CAST(account_id AS STRING) AS account_id,\\n        -- Details\\n        CAST(ad_name AS STRING) AS ad_name,\\n        CAST(ad_status AS STRING) AS ad_status,\\n        -- Metadata\\n        CAST(ad_updated_at AS TIMESTAMP) AS ad_updated_at\\n    FROM\\n        source_data\\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_ad_set_history\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_ad_set_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 113.3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\nWITH source_data AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`adgroups`\\n),\\n/*\\n    Transformations\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK\\n        CAST(ad_group_id AS STRING) AS ad_group_id,\\n        -- Details\\n        CAST(ad_group_name AS STRING) AS ad_group_name,\\n        -- Metadata\\n        CAST(ad_group_updated_at AS TIMESTAMP) AS ad_group_updated_at\\n    FROM\\n        source_data\\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_basic_all_levels\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_basic_all_levels\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 105.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_campaign_history\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"stg_facebook_ads_campaign_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 105.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\nWITH source_data AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`campaigns`\\n),\\n/*\\n    Transformations\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK\\n        CAST(campaign_id AS STRING) AS campaign_id,\\n        -- Details\\n        CAST(campaign_name AS STRING) AS campaign_name,\\n        -- Metadata\\n        CAST(campaign_updated_at AS TIMESTAMP) AS campaign_updated_at\\n    FROM\\n        source_data\\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-09-28 21:10:24\"}, {\"unique_id\": \"model.cdc_marketing.dim_facebook_ads_details\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"dim_facebook_ads_details\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 23.5, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Tables\\n*/\\n\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`int_facebook_ads_details`\", \"generated_at\": \"2026-09-28 21:10:25\"}, {\"unique_id\": \"model.cdc_marketing.int_facebook_ads_details\", \"invocation_id\": \"a5a51584-10c7-42be-a930-a4522821b23c\", \"name\": \"int_facebook_ads_details\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 108.8, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-28 21:10:25\"}, {\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_basic_all_levels\", \"invocation_id\": \"77dda030-f9b6-47a1-a857-73fba3cfbf59\", \"name\": \"stg_facebook_ads_basic_all_levels\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 4.3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n/*\\n    Tables\\n*/\\nWITH source_data AS (\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`ads_stats`\\n),\\n/*\\n    Transformations\\n*/\\nformatted AS (\\n    SELECT\\n        -- FK [Identifiers]\\n        CAST(ad_id AS STRING) AS ad_id,\\n        CAST(account_id AS STRING) AS account_id,\\n        -- Measures [METRICS (robust casting)]\\n        TRY_CAST(ad_spend AS DOUBLE) AS ad_spend,\\n        TRY_CAST(ad_impressions AS INTEGER) AS ad_impressions,\\n        TRY_CAST(ad_clicks AS INTEGER) AS ad_clicks,\\n        -- Metadata\\n        CAST(ad_date AS DATE) AS ad_date,\\n\\n        -- Platform (helpful for future union)\\n        'facebook'   AS platform\\n    FROM\\n        source_data\\n)\\nSELECT * FROM formatted\", \"generated_at\": \"2026-10-08 16:02:28\"}, {\"unique_id\": \"model.cdc_marketing.stg_snapchat_ads_stats\", \"invocation_id\": \"87202870-db6f-4513-9734-d0834b44413d\", \"name\": \"stg_snapchat_ads_stats\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 7.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-10-08 17:44:59\"}, {\"unique_id\": \"model.cdc_marketing.stg_snapchat_ads_stats\", \"invocation_id\": \"5f4b2d00-6a01-403e-a717-630454643e0d\", \"name\": \"stg_snapchat_ads_stats\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 5.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n\\n/*\\n    Staging model: Snapchat Ads daily performance stats\\n\\n    Grain: one row per ad_detail_id + ad_date + ad_country\\n    Purpose: clean raw stats, standardise types, handle dirty values\\n*/\\n\\nWITH source_data AS (\\n\\n    SELECT * \\n    FROM `bronze_production`.`cdc_staging`.`snapchat_ads_stats`\\n\\n),\\n\\ncleaned AS (\\n\\n    SELECT\\n        -- Identifiers\\n        CAST(ad_detail_id AS STRING)                        AS ad_detail_id,\\n        CAST(ad_currency_code AS STRING)                    AS ad_currency_code,\\n        CAST(ad_country AS STRING)                          AS ad_country,\\n\\n        -- Metrics (robust casting)\\n        TRY_CAST(ad_spend AS DOUBLE)                        AS ad_spend,\\n        TRY_CAST(ad_impressions AS BIGINT)                  AS ad_impressions,\\n        TRY_CAST(ad_clicks AS BIGINT)                       AS ad_clicks,\\n\\n        -- Date\\n        CAST(ad_date AS DATE)                               AS ad_date,\\n\\n        -- Original source marker\\n        CAST(data_src AS STRING)                            AS data_src,\\n\\n        -- Platform\\n        'snapchat'                                          AS platform\\n\\n    FROM source_data\\n\\n)\\n\\nSELECT * FROM cleaned\", \"generated_at\": \"2026-10-08 18:15:14\"}, {\"unique_id\": \"model.cdc_marketing.stg_snapchat_ads\", \"invocation_id\": \"a6eabe36-4868-4512-979e-462ad15db673\", \"name\": \"stg_snapchat_ads\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 4.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Staging model: Snapchat Ads (ad level)\\n\\n    Grain: one row per ad_id\\n*/\\n\\nWITH source_data AS (\\n\\n    SELECT * \\n    FROM `bronze_production`.`cdc_staging`.`snapchat_ads`\\n\\n),\\n\\ncleaned AS (\\n\\n    SELECT\\n        CAST(ad_id AS STRING)                   AS ad_id,\\n        CAST(ad_group_id AS STRING)             AS ad_group_id,\\n        CAST(ad_name AS STRING)                 AS ad_name,\\n        CAST(ad_detail_updated_at AS TIMESTAMP) AS ad_detail_updated_at,\\n\\n        'snapchat'                              AS platform\\n\\n    FROM source_data\\n\\n)\\n\\nSELECT * FROM cleaned\", \"generated_at\": \"2026-10-08 18:41:33\"}, {\"unique_id\": \"model.cdc_marketing.stg_snapchat_ads_adgroup\", \"invocation_id\": \"a6eabe36-4868-4512-979e-462ad15db673\", \"name\": \"stg_snapchat_ads_adgroup\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 4.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Staging model: Snapchat Ads ad groups\\n\\n    Grain: one row per ad_group_id\\n    Note: source contains a surrogate key and updated_at for history handling\\n*/\\n\\nWITH source_data AS (\\n\\n    SELECT * \\n    FROM `bronze_production`.`cdc_staging`.`snapchat_ads_adgroup`\\n\\n),\\n\\ncleaned AS (\\n\\n    SELECT\\n        CAST(ad_group_id AS STRING)         AS ad_group_id,\\n        CAST(campaign_id AS STRING)         AS campaign_id,\\n        CAST(ad_group_name AS STRING)       AS ad_group_name,\\n        CAST(ad_group_updated_at AS TIMESTAMP) AS ad_group_updated_at,\\n\\n        -- Keep original surrogate key in case it is useful later\\n        CAST(_surrogate_key AS STRING)      AS _surrogate_key,\\n\\n        'snapchat'                          AS platform\\n\\n    FROM source_data\\n\\n)\\n\\nSELECT * FROM cleaned\", \"generated_at\": \"2026-10-08 18:41:33\"}, {\"unique_id\": \"model.cdc_marketing.stg_snapchat_ads_campaign\", \"invocation_id\": \"a6eabe36-4868-4512-979e-462ad15db673\", \"name\": \"stg_snapchat_ads_campaign\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 4.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Staging model: Snapchat Ads campaigns\\n\\n    Grain: one row per campaign_id\\n*/\\n\\nWITH source_data AS (\\n\\n    SELECT * \\n    FROM `bronze_production`.`cdc_staging`.`snapchat_ads_campaign`\\n\\n),\\n\\ncleaned AS (\\n\\n    SELECT\\n        CAST(campaign_id AS STRING)     AS campaign_id,\\n        CAST(account_id AS STRING)      AS account_id,\\n        CAST(campaign_name AS STRING)   AS campaign_name,\\n\\n        'snapchat'                      AS platform\\n\\n    FROM source_data\\n\\n)\\n\\nSELECT * FROM cleaned\", \"generated_at\": \"2026-10-08 18:41:33\"}, {\"unique_id\": \"model.cdc_marketing.int_snapchat_ads_details\", \"invocation_id\": \"1b316c90-c5ba-4fa5-8e24-d8dc48a2ed5b\", \"name\": \"int_snapchat_ads_details\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 4.4, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Intermediate model: Snapchat Ads details\\n\\n    Purpose:\\n    - Select the latest version of each ad, ad group and campaign\\n    - Join the marketing hierarchy\\n    - Produce a clean, denormalised ad-level dimension\\n\\n    Grain: one row per ad_id\\n*/\\n\\nWITH latest_ads AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_snapchat_ads`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY ad_id\\n        ORDER BY ad_detail_updated_at DESC\\n    ) = 1\\n\\n),\\n\\nlatest_ad_groups AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_snapchat_ads_adgroup`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY ad_group_id\\n        ORDER BY ad_group_updated_at DESC\\n    ) = 1\\n\\n),\\n\\nlatest_campaigns AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_snapchat_ads_campaign`\\n    -- No updated_at column in this table, so no QUALIFY needed\\n\\n),\\n\\njoined AS (\\n\\n    SELECT\\n        a.ad_id,\\n        a.ad_group_id,\\n        ag.campaign_id,\\n        c.account_id,\\n\\n        -- Names\\n        a.ad_name,\\n        ag.ad_group_name,\\n        c.campaign_name,\\n\\n        -- Standard fields\\n        'Paid Social'                       AS channel_name,\\n        'snapchat'                          AS platform,\\n        'snapchat_ads'                      AS data_src,\\n\\n        -- Metadata\\n        a.ad_detail_updated_at,\\n        ag.ad_group_updated_at\\n\\n    FROM latest_ads a\\n    LEFT JOIN latest_ad_groups ag\\n        ON a.ad_group_id = ag.ad_group_id\\n    LEFT JOIN latest_campaigns c\\n        ON ag.campaign_id = c.campaign_id\\n\\n)\\n\\nSELECT * FROM joined\", \"generated_at\": \"2026-10-08 20:07:21\"}, {\"unique_id\": \"model.cdc_marketing.int_facebook_ads_details\", \"invocation_id\": \"0650fb60-acab-44cc-b529-18489c6c2b3c\", \"name\": \"int_facebook_ads_details\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 6.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Intermediate model: Facebook Ads details\\n\\n    Purpose:\\n    - Select the latest version of each ad, ad group, campaign and account\\n    - Join the marketing hierarchy\\n    - Produce a clean, denormalised ad-level dimension\\n\\n    Grain: one row per ad_id\\n*/\\n\\nWITH all_ads AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_ad_history`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY ad_id\\n        ORDER BY ad_updated_at DESC\\n    ) = 1\\n\\n),\\n\\nad_groups AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_ad_set_history`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY ad_group_id\\n        ORDER BY ad_group_updated_at DESC\\n    ) = 1\\n\\n),\\n\\nall_campaigns AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_campaign_history`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY campaign_id\\n        ORDER BY campaign_updated_at DESC\\n    ) = 1\\n\\n),\\n\\naccount_details AS (\\n\\n    SELECT *\\n    FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_account_history`\\n    QUALIFY ROW_NUMBER() OVER (\\n        PARTITION BY account_id\\n        ORDER BY account_updated_at DESC\\n    ) = 1\\n\\n),\\n\\njoin_all_details AS (\\n\\n    SELECT\\n        all_ads.*,\\n        ad_groups.ad_group_name,\\n        all_campaigns.campaign_name,\\n        account_details.account_name,\\n        GREATEST(\\n            all_ads.ad_updated_at,\\n            ad_groups.ad_group_updated_at,\\n            all_campaigns.campaign_updated_at,\\n            account_details.account_created_at\\n        ) AS ad_detail_updated_at\\n    FROM all_ads\\n    LEFT JOIN ad_groups\\n        ON all_ads.ad_group_id = ad_groups.ad_group_id\\n    LEFT JOIN all_campaigns\\n        ON all_ads.campaign_id = all_campaigns.campaign_id\\n    LEFT JOIN account_details\\n        ON all_ads.account_id = account_details.account_id\\n\\n),\\n\\nformatted AS (\\n\\n    SELECT\\n        ad_id,\\n        ad_group_id,\\n        campaign_id,\\n        account_id,\\n\\n        -- Details\\n        ad_name,\\n        ad_group_name,\\n        campaign_name,\\n        account_name,\\n\\n        -- Standard fields\\n        'Paid Social'           AS channel_name,\\n        'facebook'              AS platform,          -- \\u2190 added\\n        'facebook_ads'          AS data_src,\\n\\n        -- Metadata\\n        ad_detail_updated_at\\n    FROM join_all_details\\n\\n)\\n\\nSELECT * FROM formatted\", \"generated_at\": \"2026-10-08 20:51:48\"}, {\"unique_id\": \"model.cdc_marketing.fct_marketing_performance\", \"invocation_id\": \"9eedd820-34fe-4e53-b9e1-83f0113411b2\", \"name\": \"fct_marketing_performance\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 13.3, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"\\n\\n/*\\n    Final analytical model: Marketing performance\\n\\n    Purpose:\\n    - Single trusted table for analysts, BI tools and AI agents\\n    - Combines performance metrics with key descriptive attributes\\n    - Calculates standard marketing KPIs safely (CTR, CPC, CPM)\\n\\n    Grain: one row per platform + ad_id + date\\n*/\\n\\nWITH stats AS (\\n\\n    SELECT * FROM `bronze_production`.`cdc_staging`.`int_marketing_ads_stats`\\n\\n),\\n\\nfacebook_details AS (\\n\\n    SELECT\\n        ad_id,\\n        platform,\\n        campaign_id,\\n        campaign_name,\\n        ad_group_id,\\n        ad_group_name,\\n        ad_name,\\n        account_id,\\n        account_name,\\n        channel_name\\n    FROM `bronze_production`.`cdc_staging`.`int_facebook_ads_details`\\n\\n),\\n\\nsnapchat_details AS (\\n\\n    SELECT\\n        ad_id,\\n        platform,\\n        campaign_id,\\n        campaign_name,\\n        ad_group_id,\\n        ad_group_name,\\n        ad_name,\\n        account_id,\\n        CAST(NULL AS STRING) AS account_name,\\n        channel_name\\n    FROM `bronze_production`.`cdc_staging`.`int_snapchat_ads_details`\\n\\n),\\n\\ndetails AS (\\n\\n    SELECT * FROM facebook_details\\n    UNION ALL\\n    SELECT * FROM snapchat_details\\n\\n),\\n\\njoined AS (\\n\\n    SELECT\\n        s.date_day,\\n        s.platform,\\n        s.ad_id,\\n        d.ad_name,\\n        d.ad_group_id,\\n        d.ad_group_name,\\n        d.campaign_id,\\n        d.campaign_name,\\n        d.account_id,\\n        d.account_name,\\n        d.channel_name,\\n\\n        s.spend,\\n        s.impressions,\\n        s.clicks,\\n\\n        -- Safe calculated metrics\\n        CASE\\n            WHEN s.impressions > 0 THEN s.clicks * 1.0 / s.impressions\\n            ELSE NULL\\n        END AS ctr,\\n\\n        CASE\\n            WHEN s.clicks > 0 THEN s.spend / s.clicks\\n            ELSE NULL\\n        END AS cpc,\\n\\n        CASE\\n            WHEN s.impressions > 0 THEN (s.spend / s.impressions) * 1000\\n            ELSE NULL\\n        END AS cpm\\n\\n    FROM stats s\\n    LEFT JOIN details d\\n        ON  s.ad_id    = d.ad_id\\n        AND s.platform = d.platform\\n\\n)\\n\\nSELECT\\n    date_day,\\n    platform,\\n    ad_id,\\n    ad_name,\\n    ad_group_id,\\n    ad_group_name,\\n    campaign_id,\\n    campaign_name,\\n    account_id,\\n    account_name,\\n    channel_name,\\n    spend,\\n    impressions,\\n    clicks,\\n    ctr,\\n    cpc,\\n    cpm\\nFROM joined\", \"generated_at\": \"2026-10-08 20:54:42\"}, {\"unique_id\": \"model.cdc_marketing.int_marketing_ads_stats\", \"invocation_id\": \"9eedd820-34fe-4e53-b9e1-83f0113411b2\", \"name\": \"int_marketing_ads_stats\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 3.5, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"/*\\n    Intermediate model: Unified marketing ads stats\\n\\n    Purpose:\\n    - Union Facebook and Snapchat daily stats\\n    - Standardise column names\\n    - Aggregate Snapchat from (ad + day + country) \\u2192 (ad + day)\\n      so both platforms share the same grain\\n\\n    Grain: one row per platform + ad_id + date\\n*/\\n\\nWITH facebook_stats AS (\\n\\n    SELECT\\n        ad_id,\\n        ad_date                         AS date_day,\\n        'facebook'                      AS platform,\\n        ad_spend                        AS spend,\\n        ad_impressions                  AS impressions,\\n        ad_clicks                       AS clicks\\n    FROM `bronze_production`.`cdc_staging`.`stg_facebook_ads_basic_all_levels`\\n\\n),\\n\\nsnapchat_stats_raw AS (\\n\\n    SELECT\\n        ad_detail_id                    AS ad_id,\\n        ad_date                         AS date_day,\\n        'snapchat'                      AS platform,\\n        ad_spend                        AS spend,\\n        ad_impressions                  AS impressions,\\n        ad_clicks                       AS clicks\\n    FROM `bronze_production`.`cdc_staging`.`stg_snapchat_ads_stats`\\n\\n),\\n\\nsnapchat_stats AS (\\n\\n    SELECT\\n        ad_id,\\n        date_day,\\n        platform,\\n        SUM(spend)                      AS spend,\\n        SUM(impressions)                AS impressions,\\n        SUM(clicks)                     AS clicks\\n    FROM snapchat_stats_raw\\n    GROUP BY 1, 2, 3\\n\\n),\\n\\nunioned AS (\\n\\n    SELECT * FROM facebook_stats\\n    UNION ALL\\n    SELECT * FROM snapchat_stats\\n\\n)\\n\\nSELECT * FROM unioned\", \"generated_at\": \"2026-10-08 20:54:42\"}]--ELEMENTARY-MACRO-OUTPUT-END--"}, "info": {"category": "", "code": "I062", "extra": {}, "invocation_id": "56072a32-3f62-4086-878b-df1966ed3f62", "level": "info", "msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.cdc_marketing.stg_facebook_ads_account_history\", \"invocation_id\": \"3e0d9aab-39a9-469c-b3f0-29ca489dcaf7\", \"name\": \"stg_facebook_ads_account_history\", \"schema\": \"cdc_staging\", \"status\": \"success\", \"execution_time\": 25.1, \"full_refresh\": false, \"materialization\"