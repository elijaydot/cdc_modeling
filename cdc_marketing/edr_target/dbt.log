{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"6344e4d3-5471-4203-90b3-f664fb6d58e2\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"6344e4d3-5471-4203-90b3-f664fb6d58e2\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'seed' as type\n        from `bronze_production`.`cdc_staging`.`dbt_seeds`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'snapshot' as type\n        from `bronze_production`.`cdc_staging`.`dbt_snapshots`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'model' as type\n        from `bronze_production`.`cdc_staging`.`dbt_models`\n        \n            where package_name != 'elementary'\n        \n        union all\n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'source' as type\n        from `bronze_production`.`cdc_staging`.`dbt_sources`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            null as materialization,\n            'exposure' as type\n        from `bronze_production`.`cdc_staging`.`dbt_exposures`\n    \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "6344e4d3-5471-4203-90b3-f664fb6d58e2", "level": "debug", "msg": "On macro_log_